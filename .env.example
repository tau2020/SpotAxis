# ---------------------------------------------------------------------------
# SpotAxis environment configuration
# Copy to `.env` and adjust. All values below are SAFE LOCAL PLACEHOLDERS.
# Never commit real secrets or point this at a production database.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY='django-insecure-change-me-local-only'
# local_development | server_development | productive
ENVIRONMENT='local_development'
allowed_hosts='*'
TIME_ZONE='Asia/Kolkata'

# --- Host / URL configuration ----------------------------------------------
# TRM.middleware.SubdomainMiddleware 404s any host that is neither a known
# company subdomain nor the host part of `site_suffix`. macOS and Linux both
# resolve *.localhost to 127.0.0.1, so no /etc/hosts edit is needed: the main
# site is spotaxis.localhost and each company career site is
# <slug>.spotaxis.localhost. TRM.settings.ROOT_DOMAIN is 'spotaxis', so the
# middle label has to stay 'spotaxis'. Keep the port in site_suffix in sync
# with the port you pass to `runserver` -- company/vacancy URLs are built
# from it.
site_url='http://spotaxis.localhost:8010'
site_suffix='.spotaxis.localhost:8010/'
# Host-only cookies. A shared '.spotaxis.localhost' domain cookie is not
# accepted by every browser, so log in separately per subdomain locally.
session_cookie_domain=''

# --- Database ---------------------------------------------------------------
# Matches the MySQL 8.4 container in LOCAL_DEVELOPMENT.md (published on 3307
# to stay clear of any MySQL already running on the default 3306).
db_engine='django.db.backends.mysql'
db_name='TRM_local'
db_user='TRM_user'
db_password='spotaxis_local_pass'
db_host='127.0.0.1'
db_port='3307'

# --- Email ------------------------------------------------------------------
# Console backend prints mail to the runserver terminal; no SMTP account needed.
email_backend='django.core.mail.backends.console.EmailBackend'
email_host='localhost'
email_host_user='noreply@localhost'
email_host_passw=''
email_port=1025
email_use_tls=False
default_from_email='SpotAxis <noreply@localhost>'
server_email='SpotAxis <server@localhost>'
notification_emails='notify@localhost'

# --- Media & static ---------------------------------------------------------
media_url='/media/'
# Defaults to TRM/media and TRM/static when unset.
media_root=''
static_root=''
static_dir=''
logo_email='http://spotaxis.localhost:8010/static/img/logo/logo.png'

# --- Third-party credentials (all optional for local development) -----------
# Leave blank unless you are actively testing that integration.
paypal_client_id=''
paypal_app_secret=''
paypal_merchant_id=''
paypal_access_token=''
paypal_account=''
facebook_oauth_key=''
facebook_oauth_secret=''
linkedin_oauth_key=''
linkedin_oauth_secret=''
angel_oauth_key=''
angel_oauth_secret=''
twitter_oauth_key=''
twitter_oauth_secret=''
googleplus_oauth_key=''
googleplus_oauth_secret=''
github_oauth_key=''
github_oauth_secret=''
stackoverflow_oauth_key=''
stackoverflow_oauth_secret=''
stackoverflow_oauth_requestkey=''
