# Copy to .env for local development. Every value here is a safe placeholder.
# Production values are set as environment variables on the host (Railway).

# --- Core ---------------------------------------------------------------
ENVIRONMENT=local_development
DEBUG=true
# Generate: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
TIME_ZONE=UTC

# --- Hosts --------------------------------------------------------------
# Company careers sites live at <slug>SITE_SUFFIX; the host part is the main site.
# The port must match the port you run the dev server on.
SITE_SUFFIX=.spotaxis.localhost:8010/
# Extra hosts that should serve the main site (comma separated), e.g. a Railway domain.
MAIN_HOSTS=
ALLOWED_HOSTS=.spotaxis.localhost,localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://spotaxis.com,https://*.spotaxis.com

# --- Database -----------------------------------------------------------
DATABASE_URL=postgres://localhost:5432/spotaxis

# --- Email --------------------------------------------------------------
# Console backend prints mail to the runserver terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SpotAxis <noreply@spotaxis.localhost>
NOTIFICATION_EMAILS=

# --- Files --------------------------------------------------------------
# MEDIA_ROOT defaults to ./media; SERVE_MEDIA=true serves it through Django.
SERVE_MEDIA=true

# --- Scheduled tasks ----------------------------------------------------
# Bearer token expected by POST /internal/tasks/run (leave blank to disable).
TASK_RUNNER_TOKEN=

# --- Monitoring ---------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO
